# FinSight AI Environment Configuration

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=8501
SECRET_KEY=dev-secret-key-change-in-production-finsight-928374
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///./finsight.db

# Regional / Currency Settings
DEFAULT_CURRENCY=BDT
SUPPORTED_CURRENCIES=BDT,USD,EUR,GBP
BDT_MIN_SAFETY_BUFFER=500.0

# Decision Policy Parameters
COST_FALSE_NEGATIVE=5.0
COST_FALSE_POSITIVE=1.0
DEFAULT_FORECAST_HORIZON_DAYS=7

# Agent & LLM (Optional adapter - deterministic fallback active if unconfigured)
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=5.0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
